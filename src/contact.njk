---
layout: base.njk
title: "Contact GS Visibility | Free SEO Mini-Audit"
description: "Contact GS Visibility for a free SEO mini-audit. Call or message on WhatsApp on +92 342 3528805, email info@gsvisibility.com, or use the contact form."
---
{% from "breadcrumbs.njk" import crumbs %}
{{ crumbs([{name: "Home", url: "/"}, {name: "Contact", url: "/contact/"}], site.url) }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "{{ site.url }}/contact/#webpage",
  "url": "{{ site.url }}/contact/",
  "name": {{ title | dump | safe }},
  "isPartOf": {"@id": "{{ site.url }}/#website"},
  "about": {"@id": "{{ site.url }}/#organization"},
  "inLanguage": "{{ site.locale }}"
}
</script>

<section class="page-hero">
  <div class="wrap">
    <h1>Get a free SEO mini-audit</h1>
    <p class="lede">Share your website address and a few details about your business, and we will send back three specific improvements you can make this week. It is free and carries no obligation.</p>
  </div>
</section>

<section>
  <div class="wrap contact-layout">
    <div class="contact-card">
      <h2>Send us the details</h2>
      <form class="contact-form" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact">
        <p class="visually-hidden"><label>Leave this empty if you are human: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

        <label for="name">Your name</label>
        <input type="text" id="name" name="name" autocomplete="name" required>

        <label for="email">Email address</label>
        <input type="email" id="email" name="email" autocomplete="email" required>

        <label for="website">Your website (optional)</label>
        <input type="text" id="website" name="website" inputmode="url" autocomplete="url" placeholder="example.com">

        <label for="region">Where is your business based?</label>
        <select id="region" name="region" required>
          <option value="" disabled selected>Choose one</option>
          <option>United Kingdom</option>
          <option>Ireland</option>
          <option>Elsewhere in Europe</option>
          <option>Australia</option>
          <option>Somewhere else</option>
        </select>

        <label for="message">What do you need help with?</label>
        <textarea id="message" name="message" required></textarea>

        <button type="submit" class="btn btn-primary">Send message</button>
        <p class="form-note">We use your details only to reply to your enquiry. See our <a href="/privacy-policy/">privacy policy</a>.</p>
      </form>
    </div>

    <div class="contact-card">
      <h2>Or reach us directly</h2>
      <ul class="contact-list">
        <li><span class="label">Phone and WhatsApp</span><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li><span class="label">WhatsApp message</span><a href="{{ site.whatsapp }}">Chat on WhatsApp</a></li>
        <li><span class="label">Email</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><span class="label">LinkedIn</span><a href="{{ site.linkedin }}" rel="noopener">{{ site.founder }}</a></li>
        <li><span class="label">Based in</span><span>{{ site.location }}, working remotely with clients in Europe and Australia</span></li>
      </ul>
    </div>
  </div>
</section>
