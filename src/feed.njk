---
permalink: feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.name }} blog</title>
  <subtitle>Practical SEO tips for small businesses in Europe and Australia</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/blog/</id>
  {%- if collections.posts.length %}
  <updated>{{ (collections.posts[0].data.updated or collections.posts[0].date) | isoDate }}</updated>
  {%- else %}
  <updated>2026-11-26T00:00:00.000Z</updated>
  {%- endif %}
  <author><name>{{ site.founder }}</name></author>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | isoDate }}</published>
    <updated>{{ (post.data.updated or post.date) | isoDate }}</updated>
    <summary>{{ post.data.meta_description or post.data.description }}</summary>
  </entry>
  {%- endfor %}
</feed>
