---
layout: base.njk
ogType: article
---
{% from "breadcrumbs.njk" import crumbs %}
{{ crumbs([{name: "Home", url: "/"}, {name: "Blog", url: "/blog/"}, {name: title, url: page.url}], site.url) }}

<article>
  <header class="post-header">
    <div class="wrap">
      {% if featured_image %}<img class="post-cover" src="{{ featured_image }}" alt="{{ featured_image_alt or title }}" width="1200" height="630" fetchpriority="high">{% endif %}
      <h1>{{ title }}</h1>
      <p class="post-meta">By {{ author or site.founder }} &middot; <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% if updated %} &middot; Updated <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time>{% endif %}</p>
      {% if tags %}<div class="post-tags">{% for tag in tags %}<span class="pill">{{ tag }}</span>{% endfor %}</div>{% endif %}
    </div>
  </header>
  <div class="post-body-wrap">
    <div class="wrap prose">
      {{ content | safe }}
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": "{{ site.url }}{{ page.url }}#article",
  "headline": {{ title | dump | safe }},
  "description": {{ (meta_description or description) | dump | safe }},
  "image": ["{{ site.url }}{{ featured_image or '/assets/img/og-image.png' }}"],
  "author": {"@type": "Person", "name": {{ (author or site.founder) | dump | safe }}, "url": "{{ site.url }}/about/"},
  "publisher": {"@id": "{{ site.url }}/#organization"},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (updated or date) | isoDate }}",
  "mainEntityOfPage": {"@type": "WebPage", "@id": "{{ site.url }}{{ page.url }}"},
  "inLanguage": "{{ site.locale }}"{% if tags %},
  "keywords": {{ tags | join(", ") | dump | safe }}{% endif %}
}
</script>

<section>
  <div class="wrap">
    <h2>Want help applying this to your own site?</h2>
    <p>Our SEO services, if you would rather hand it over:</p>
    <div class="related">
      {% for s in site.services %}<a class="pill" href="{{ s.url }}">{{ s.name }}</a>{% endfor %}
    </div>
  </div>
</section>

<section class="contact-band">
  <div class="wrap">
    <h2>Get a free mini-audit</h2>
    <p>Send us your website address and we will reply with three quick improvements you can make to it.</p>
    <div class="contact-ctas">
      <a class="btn btn-light" href="/contact/">Get a free mini-audit</a>
      <a class="text-link" href="{{ site.whatsapp }}">Chat on WhatsApp</a>
    </div>
  </div>
</section>
