---
layout: base.njk
---
<section class="post-header">
  <div class="wrap">
    {% if featured_image %}<img src="{{ featured_image }}" alt="{{ title }}">{% endif %}
    <h1>{{ title }}</h1>
    <p class="post-meta">{{ date | readableDate }} · {{ author }}</p>
    {% if tags %}
    <div class="post-tags">
      {% for tag in tags %}<span class="pill">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<section class="post-body">
  <div class="wrap">
    <div class="post-body">
      {{ content | safe }}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ (meta_description or description) | dump | safe }},
  "image": "{{ site.url }}{{ featured_image or '/assets/og-share-image.png' }}",
  "author": {"@type": "Person", "name": {{ author | dump | safe }}},
  "datePublished": "{{ date | htmlDateString }}",
  "publisher": {
    "@type": "Organization",
    "name": "Bhawani Growth",
    "logo": {"@type": "ImageObject", "url": "{{ site.url }}/assets/logo.png"}
  },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>

<section class="service-cta">
  <div class="wrap">
    <h2>Want help applying this to your own site?</h2>
    <p>Send your site over and I'll reply with specific, practical fixes — no generic checklist, no pressure.</p>
    <a class="btn btn-primary" href="{{ site.whatsapp }}">Chat on WhatsApp</a>
  </div>
</section>
