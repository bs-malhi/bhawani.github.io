---
layout: base.njk
---
<section class="service-hero">
  <div class="wrap">
    <h1>{{ heroTitle }}</h1>
    <p class="lede">{{ heroIntro }}</p>
    <a class="btn btn-primary" href="{{ site.whatsapp }}">Chat on WhatsApp</a>
  </div>
</section>

<section class="service-body">
  <div class="wrap">
    {{ content | safe }}
  </div>
</section>

{% if faqs %}
<section class="service-faqs">
  <div class="wrap">
    <h2>Frequently asked questions</h2>
    {% for item in faqs %}
    <div class="faq-item">
      <h3>{{ item.q }}</h3>
      <p>{{ item.a }}</p>
    </div>
    {% endfor %}
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqs %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": {"@type": "Answer", "text": {{ item.a | dump | safe }}}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": {{ heroTitle | dump | safe }},
  "provider": {"@type": "ProfessionalService", "name": "Bhawani Growth", "url": "{{ site.url }}/"},
  "areaServed": "Worldwide",
  "description": {{ description | dump | safe }}
}
</script>

<section class="service-cta">
  <div class="wrap">
    <h2>Ready to find out what's holding your site back?</h2>
    <p>Send your site over and I'll reply with specific, practical fixes — no generic checklist, no pressure.</p>
    <a class="btn btn-primary" href="{{ site.whatsapp }}">Chat on WhatsApp</a>
  </div>
</section>
