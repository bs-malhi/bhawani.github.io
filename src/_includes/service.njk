---
layout: base.njk
---
{% from "breadcrumbs.njk" import crumbs %}
{{ crumbs([{name: "Home", url: "/"}, {name: "Services", url: "/services/"}, {name: serviceName, url: page.url}], site.url) }}

<section class="service-hero">
  <div class="wrap">
    <h1>{{ heroTitle }}</h1>
    <p class="lede">{{ heroIntro }}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="/contact/">Get a free mini-audit</a>
      <a class="text-link" href="{{ site.whatsapp }}">Chat on WhatsApp</a>
    </div>
  </div>
</section>

<section class="service-body">
  <div class="wrap prose">
    {{ content | safe }}
  </div>
</section>

{% if faqs %}
<section class="service-faqs">
  <div class="wrap">
    <h2>Frequently asked questions</h2>
    {% for item in faqs %}
    <div class="faq-item">
      <h3>{{ item.q }}</h3>
      <p>{{ item.a }}</p>
    </div>
    {% endfor %}
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqs %}
    {"@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ item.a | dump | safe }}}}{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "{{ site.url }}{{ page.url }}#service",
  "name": {{ serviceName | dump | safe }},
  "serviceType": {{ serviceName | dump | safe }},
  "description": {{ description | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  "provider": {"@id": "{{ site.url }}/#organization"},
  "areaServed": [{"@type": "Continent", "name": "Europe"}, {"@type": "Country", "name": "Australia"}]
}
</script>

<section>
  <div class="wrap">
    <h2>Our other SEO services</h2>
    <div class="related">
      {% for s in site.services %}{% if s.url != page.url %}<a class="pill" href="{{ s.url }}">{{ s.name }}</a>{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="contact-band">
  <div class="wrap">
    <h2>{{ ctaHeading }}</h2>
    <p>{{ ctaText }}</p>
    <div class="contact-ctas">
      <a class="btn btn-light" href="/contact/">Get a free mini-audit</a>
      <a class="text-link" href="{{ site.whatsapp }}">Chat on WhatsApp</a>
    </div>
    <div class="contact-details">
      <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
</section>
