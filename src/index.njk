---
layout: base.njk
title: "GS Visibility | Small Business SEO, Europe & Australia"
description: "An SEO team helping small businesses in Europe and Australia rank higher on Google: technical audits, on-page SEO, local SEO and keyword research."
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["ProfessionalService", "Organization"],
      "@id": "{{ site.url }}/#organization",
      "name": {{ site.name | dump | safe }},
      "alternateName": {{ site.alternateName | dump | safe }},
      "url": "{{ site.url }}/",
      "logo": {"@type": "ImageObject", "@id": "{{ site.url }}/#logo", "url": "{{ site.url }}/assets/img/gs-visibility-logo-512.png", "width": 512, "height": 512, "caption": {{ site.name | dump | safe }}},
      "image": "{{ site.url }}/assets/img/og-image.png",
      "description": {{ site.description | dump | safe }},
      "email": "{{ site.email }}",
      "telephone": "{{ site.phoneHref }}",
      "address": {"@type": "PostalAddress", "addressLocality": "Karachi", "addressCountry": "PK"},
      "areaServed": [{"@type": "Continent", "name": "Europe"}, {"@type": "Country", "name": "Australia"}],
      "knowsLanguage": "en",
      "founder": {"@type": "Person", "name": {{ site.founder | dump | safe }}, "sameAs": "{{ site.linkedin }}"},
      "contactPoint": [{"@type": "ContactPoint", "contactType": "customer service", "telephone": "{{ site.phoneHref }}", "email": "{{ site.email }}", "availableLanguage": "English", "areaServed": ["Europe", "Australia"]}],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "SEO services",
        "itemListElement": [
          {% for s in site.services %}{"@type": "Offer", "itemOffered": {"@type": "Service", "name": {{ s.name | dump | safe }}, "url": "{{ site.url }}{{ s.url }}"}}{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": {{ site.name | dump | safe }},
      "alternateName": {{ site.alternateName | dump | safe }},
      "inLanguage": "{{ site.locale }}",
      "publisher": {"@id": "{{ site.url }}/#organization"}
    },
    {
      "@type": "WebPage",
      "@id": "{{ site.url }}/#webpage",
      "url": "{{ site.url }}/",
      "name": {{ title | dump | safe }},
      "isPartOf": {"@id": "{{ site.url }}/#website"},
      "about": {"@id": "{{ site.url }}/#organization"},
      "inLanguage": "{{ site.locale }}"
    }
  ]
}
</script>

